# ============================================================================
# The Lenny Growth Assistant — environment configuration
# Copy to `.env` and fill in secrets. NEVER commit .env.
# ============================================================================

# ---- App -------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS (the Vite dev server / web container)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:5174

# ---- Model provider toggle -------------------------------------------------
# The ONE switch that changes the model without touching app code.
#   cloud  -> OpenAI (via LiteLLM proxy)
#   local  -> Ollama (via LiteLLM proxy)   <-- mandatory for the demo
LLM_PROVIDER=local

# Which agent backend runs the loop:
#   agent_sdk -> Claude Agent SDK routed through the LiteLLM Anthropic proxy (faithful path)
#   litellm   -> direct LiteLLM tool-calling loop (de-risked fallback, same skills)
AGENT_BACKEND=agent_sdk

# ---- Cloud (OpenAI) --------------------------------------------------------
# Required only when LLM_PROVIDER=cloud. Leave blank to force local-only.
OPENAI_API_KEY=
# Default cloud model (cost-friendly); gpt-4.1 available for hardest tasks.
OPENAI_MODEL=gpt-4o-mini

# ---- Local (Ollama) --------------------------------------------------------
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b

# ---- Embeddings (fixed to ONE model across both providers) -----------------
# One embedding space keeps the vector index provider-independent.
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# ---- LiteLLM proxy (Anthropic /v1/messages passthrough for the Agent SDK) --
LITELLM_PROXY_URL=http://litellm:4000
# Master key the proxy requires; the Agent SDK sends it as ANTHROPIC_AUTH_TOKEN.
LITELLM_MASTER_KEY=sk-lenny-local-dev

# ---- Database (Postgres + pgvector) ----------------------------------------
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny
POSTGRES_DB=lenny
# Async driver DSN used by the API (host `db` inside compose, `localhost` natively)
DATABASE_URL=postgresql://lenny:lenny@db:5432/lenny

# ---- Retrieval tuning ------------------------------------------------------
RETRIEVAL_TOP_K=6
# Cosine similarity floor; below this we answer "not covered by the transcripts".
RETRIEVAL_MIN_SCORE=0.25

# ---- Ingestion -------------------------------------------------------------
TRANSCRIPTS_REPO=https://github.com/ChatPRD/lennys-podcast-transcripts.git
# Cap episodes for a fast demo ingest; set 0 to ingest all.
INGEST_MAX_EPISODES=50


# Personal GitHub token (classic PAT with `repo` scope). Set in your local .env, never commit the real value.
PERSONAL_GITHUB_TOKEN=